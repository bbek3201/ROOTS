# ---------------------------------------------------------------------------
# ROOTS environment
# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NOTHING secret may use the NEXT_PUBLIC_ prefix:
# anything so prefixed is compiled into the browser bundle.
# ---------------------------------------------------------------------------

# Safe to expose. The anon key is powerless on its own — every table is behind RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS. Never import this from a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# AI provider (optional)
# ---------------------------------------------------------------------------
# Leave ROOTS_AI_PROVIDER unset or set it to "mock" to run without any AI
# service. The mock provider is deterministic, invents nothing, and every
# response it returns is flagged is_mock so the UI labels it visibly.
ROOTS_AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ROOTS_AI_MODEL=claude-sonnet-5
